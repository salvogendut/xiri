#!/bin/sh
# Prepare a native account and identify its local installed IRIX donor.
set -eu
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
fail() { printf 'xiriprep: %s\n' "$*" >&2; exit 1; }
usage() { echo 'usage: xiriprep [--check] [--allow-shutdown] --source disk-image --user login'; }

source_image= login= check=no allow_shutdown=no
while [ "$#" -gt 0 ]; do
    case $1 in
    --help) usage; exit 0 ;;
    --check) check=yes; shift ;;
    --allow-shutdown) allow_shutdown=yes; shift ;;
    --source) [ "$#" -ge 2 ] && [ -z "$source_image" ] || fail "$(usage)"
        source_image=$2; shift 2 ;;
    --user) [ "$#" -ge 2 ] && [ -z "$login" ] || fail "$(usage)"
        login=$2; shift 2 ;;
    *) fail "$(usage)" ;;
    esac
done
[ -n "$source_image" ] && [ -n "$login" ] || fail "$(usage)"
[ "$(uname -s)" = NetBSD ] && [ "$(id -u)" = 0 ] || fail 'run as root on the XiriBSD machine'
case $login in -*|*:*|*/*|*[![:print:]]*|[0-9]*) fail 'supply a native login name' ;; esac
[ -f "$source_image" ] && [ -r "$source_image" ] || fail "cannot read image file: $source_image"
case $source_image in /*) ;; *) source_image=./$source_image ;; esac
source_image=$(realpath "$source_image") || fail 'cannot resolve source path'
for suffix in .overlay .overlay.dirty .diff .diff.chd .diff.chd.overlay .diff.chd.overlay.dirty; do
    if [ -s "$source_image$suffix" ]; then
        fail "found $source_image$suffix; use a merged export of the stopped donor"
    fi
done

reader=/usr/local/libexec/xiri/xiri-donor-read
shell_hash=$("$reader" --sha256 "$source_image" /sbin/sh) || fail 'could not read the IRIX shell'
wm_hash=$("$reader" --sha256 "$source_image" /usr/bin/X11/4Dwm) || fail 'could not read IRIX 4Dwm'
toolchest_hash=$("$reader" --sha256 "$source_image" /usr/bin/X11/toolchest) || fail 'could not read Toolchest'
profile=
for plan in /usr/local/share/xiri/plans/*.plan; do
    [ -f "$plan" ] || continue
    if awk -F '|' -v sh="$shell_hash" -v wm="$wm_hash" -v chest="$toolchest_hash" '
        $1 == "f" && $3 == "/sbin/sh" && $5 == sh { shell = 1 }
        $1 == "f" && $3 == "/usr/bin/X11/4Dwm" && $5 == wm { manager = 1 }
        $1 == "f" && $3 == "/usr/bin/X11/toolchest" && $5 == chest { menu = 1 }
        END { exit !(shell && manager && menu) }' "$plan"; then
        [ -z "$profile" ] || fail 'multiple desktop import plans match this donor'
        profile=${plan##*/}
    fi
done
[ -n "$profile" ] || fail 'unrecognized donor installation: shell, 4Dwm and Toolchest do not match a qualified desktop profile'
release=${profile%.plan}
release=${release%%-*}
case $release in 6.5.22f|6.5.22m|6.5.30f) ;; *) fail "unsupported desktop profile: $profile" ;; esac
printf 'Identified IRIX %s from %s\n' "$release" "$source_image"
printf 'Desktop profile: %s\n' "$profile"

receipt=/var/db/xiri-install/installed
desktop_ready=no
check_desktop() {
    read -r installed_release archives < "$receipt" || fail 'cannot read the installed desktop receipt'
    [ "$installed_release" = "$release" ] || fail "shared desktop is IRIX $installed_release; donor is $release"
    cmp -s "$receipt" /var/db/xiri-install/inputs &&
        cmp -s "$receipt" /emul/irix/.xiri-install-inputs &&
        cmp -s "$receipt" /usr/local/share/xiri/fonts/.xiri-install-inputs &&
        [ -x /usr/local/bin/xiri-session ] && [ -r /usr/local/share/xiri/xdm.xsession ] ||
        fail 'shared desktop installation is incomplete'
}
if [ -f "$receipt" ]; then
    check_desktop
    desktop_ready=yes
fi

create=no
if entry=$(getent passwd "$login"); then
    [ "$(printf '%s\n' "$entry" | cut -d: -f1)" = "$login" ] || fail 'account lookup differs from requested login'
    [ "$(id -u "$login")" -ne 0 ] || fail 'select an ordinary desktop user'
    account_home=$(printf '%s\n' "$entry" | cut -d: -f6)
    printf 'Using existing NetBSD account %s, home %s\n' "$login" "$account_home"
else
    case $login in ''|*[!a-z0-9_-]*|[0-9-]*) fail 'invalid new account name' ;; esac
    if [ "$check" = yes ]; then
        printf 'Account %s does not exist. Preparation will offer to create it in the operator group for desktop shutdown.\n' "$login"
        exit 0
    fi
    [ -t 0 ] || fail "account $login is missing; run interactively or create it first"
    printf 'Create NetBSD account %s with home /usr/people/%s and operator access (shutdown and raw devices)? [y/N] ' "$login" "$login"
    IFS= read -r answer || fail 'account creation cancelled'
    case $answer in y|Y|yes|YES) ;; *) fail 'account creation declined' ;; esac
    create=yes
fi
[ "$check" = no ] || exit 0
if [ "$desktop_ready" = no ]; then
    /bin/sh /usr/local/libexec/xiri/install-shared.sh "$source_image" "$release" "$profile"
fi
check_desktop
case $profile in
    6.5.22f.plan|6.5.30f.plan)
        # A previously prepared desktop can be presented with a different
        # donor of the same release. Match its installed profile first.
        if [ "$(sha256 -q /emul/irix/usr/bin/X11/toolchest)" = "$toolchest_hash" ]; then
            /bin/sh /usr/local/libexec/xiri/install-audio.sh "$source_image" \
                "/usr/local/share/xiri/plans/$release.audio" ||
                printf '%s\n' 'xiriprep: optional audio clients incomplete; continuing desktop setup' >&2
        fi ;;
esac
if [ "$create" = yes ]; then
    account=$(/usr/local/libexec/xiri/setup-xiri-user.sh "$login")
    printf '%s\n' "$account"
    case $account in
        "XIRI_USER created "*) allow_shutdown=yes ;;
        *) fail "account $login already exists; rerun to prepare the existing account" ;;
    esac
fi
if [ "$allow_shutdown" = yes ]; then
    # NetBSD usermod -G appends to the user's supplementary groups.
    if ! id -Gn "$login" | tr ' ' '\n' | grep -qx operator; then
        usermod -G operator "$login" || fail "could not add $login to operator"
    fi
    su -f "$login" -c 'test -x /sbin/shutdown' || fail "$login cannot execute /sbin/shutdown"
    printf 'Desktop shutdown enabled for %s at the next login.\n' "$login"
fi
if [ "$create" = yes ]; then
    passwd "$login" || fail "account $login exists; set its password with passwd before graphical login"
fi
/usr/local/sbin/xiri-sync-users
su -f "$login" -c 'exec /bin/sh /usr/local/libexec/xiri/select-desktop.sh'
printf 'IRIX %s desktop selected for %s at the next xdm login.\n' "$release" "$login"
