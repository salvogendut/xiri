#!/bin/sh
# Prepare a native account and identify its local installed IRIX donor.
set -eu
PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
fail() { printf 'xiriprep: %s\n' "$*" >&2; exit 1; }
usage() { echo 'usage: xiriprep [--check] --source disk-image --user login'; }

source_image= login= check=no
while [ "$#" -gt 0 ]; do
    case $1 in
    --help) usage; exit 0 ;;
    --check) check=yes; shift ;;
    --source) [ "$#" -ge 2 ] && [ -z "$source_image" ] || fail "$(usage)"
        source_image=$2; shift 2 ;;
    --user) [ "$#" -ge 2 ] && [ -z "$login" ] || fail "$(usage)"
        login=$2; shift 2 ;;
    *) fail "$(usage)" ;;
    esac
done
[ -n "$source_image" ] && [ -n "$login" ] || fail "$(usage)"
[ "$(uname -s)" = NetBSD ] && [ "$(id -u)" = 0 ] || fail 'run as root on the XiriBSD machine'
case $login in -*|*:*|*/*|*[![:print:]]*|[0-9]*) fail 'supply a native login name' ;; esac
[ -f "$source_image" ] && [ -r "$source_image" ] || fail "cannot read image file: $source_image"
case $source_image in /*) ;; *) source_image=./$source_image ;; esac
source_image=$(realpath "$source_image") || fail 'cannot resolve source path'
for suffix in .overlay .overlay.dirty .diff .diff.chd .diff.chd.overlay .diff.chd.overlay.dirty; do
    if [ -s "$source_image$suffix" ]; then
        fail "found $source_image$suffix; use a merged export of the stopped donor"
    fi
done

reader=/usr/local/libexec/xiri/xiri-donor-read
profiles=/usr/local/share/xiri/donor-signatures
shell_hash=$("$reader" --sha256 "$source_image" /sbin/sh) || fail 'could not read the IRIX shell'
wm_hash=$("$reader" --sha256 "$source_image" /usr/bin/X11/4Dwm) || fail 'could not read IRIX 4Dwm'
release=$(awk -v sh="$shell_hash" -v wm="$wm_hash" '$2 == sh && $3 == wm {print $1}' "$profiles")
case $release in 6.5.22f|6.5.30f) ;; *) fail 'donor shell and 4Dwm do not match a supported release profile' ;; esac
printf 'Identified IRIX %s from %s\n' "$release" "$source_image"

receipt=/var/db/xiri-install/installed
desktop_ready=no
check_desktop() {
    read -r installed_release archives < "$receipt" || fail 'cannot read the installed desktop receipt'
    [ "$installed_release" = "$release" ] || fail "shared desktop is IRIX $installed_release; donor is $release"
    cmp -s "$receipt" /var/db/xiri-install/inputs &&
        cmp -s "$receipt" /emul/irix/.xiri-install-inputs &&
        cmp -s "$receipt" /usr/local/share/xiri/fonts/.xiri-install-inputs &&
        [ -x /usr/local/bin/xiri-session ] && [ -r /usr/local/share/xiri/xdm.xsession ] ||
        fail 'shared desktop installation is incomplete'
}
if [ "$check" = no ] && [ -f "$receipt" ]; then
    check_desktop
    desktop_ready=yes
fi

if entry=$(getent passwd "$login"); then
    [ "$(printf '%s\n' "$entry" | cut -d: -f1)" = "$login" ] || fail 'account lookup differs from requested login'
    [ "$(id -u "$login")" -ne 0 ] || fail 'select an ordinary desktop user'
    account_home=$(printf '%s\n' "$entry" | cut -d: -f6)
    printf 'Using existing NetBSD account %s, home %s\n' "$login" "$account_home"
else
    case $login in ''|*[!a-z0-9_-]*|[0-9-]*) fail 'invalid new account name' ;; esac
    if [ "$check" = yes ]; then
        printf 'Account %s does not exist. Preparation will offer to create it.\n' "$login"
        exit 0
    fi
    [ -t 0 ] || fail "account $login is missing; run interactively or create it first"
    printf 'Create NetBSD account %s with home /usr/people/%s? [y/N] ' "$login" "$login"
    IFS= read -r answer || fail 'account creation cancelled'
    case $answer in y|Y|yes|YES) ;; *) fail 'account creation declined' ;; esac
    account=$(/usr/local/libexec/xiri/setup-xiri-user.sh "$login")
    printf '%s\n' "$account"
    case $account in
        "XIRI_USER created "*) passwd "$login" || fail "account $login exists; set its password with passwd before graphical login" ;;
    esac
fi
[ "$check" = no ] || exit 0
if [ "$desktop_ready" = no ]; then
    /bin/sh /usr/local/libexec/xiri/install-shared.sh "$source_image" "$release"
fi
check_desktop
/usr/local/sbin/xiri-sync-users
su -f "$login" -c 'exec /bin/sh /usr/local/libexec/xiri/select-desktop.sh'
printf 'IRIX %s desktop selected for %s at the next xdm login.\n' "$release" "$login"
