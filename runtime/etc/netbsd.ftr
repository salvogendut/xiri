# Native NetBSD/mips executables with an ELF32 big-endian PT_INTERP.
# IRIX's GenericExecutable excludes EF_MIPS_PIC, which native PIE uses too.
TYPE XiriNetBSDExecutable
    SUPERTYPE Executable
    MATCH size >= 52 && (mode & 0111) && char(0) == 0x7f &&
          string(1,3) == "ELF" && uchar(4) == 1 && uchar(5) == 2 &&
          ushort(18) == 8 && (ushort(16) == 2 || ushort(16) == 3) &&
          ushort(42) == 32 && ushort(44) > 0 && ushort(44) <= 32 &&
          size >= 52 + ushort(44) * 32 && ulong(28) >= 52 && ulong(28) <= size - ushort(44) * 32 &&
          (
           (ushort(44) > 0 && ulong(ulong(28)+0) == 3 &&
               ulong(ulong(28)+0+16) == 23 && ulong(ulong(28)+0+4) <= size-23 &&
               string(ulong(ulong(28)+0+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+0+4)+22) == 0)
           || (ushort(44) > 1 && ulong(ulong(28)+32) == 3 &&
               ulong(ulong(28)+32+16) == 23 && ulong(ulong(28)+32+4) <= size-23 &&
               string(ulong(ulong(28)+32+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+32+4)+22) == 0)
           || (ushort(44) > 2 && ulong(ulong(28)+64) == 3 &&
               ulong(ulong(28)+64+16) == 23 && ulong(ulong(28)+64+4) <= size-23 &&
               string(ulong(ulong(28)+64+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+64+4)+22) == 0)
           || (ushort(44) > 3 && ulong(ulong(28)+96) == 3 &&
               ulong(ulong(28)+96+16) == 23 && ulong(ulong(28)+96+4) <= size-23 &&
               string(ulong(ulong(28)+96+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+96+4)+22) == 0)
           || (ushort(44) > 4 && ulong(ulong(28)+128) == 3 &&
               ulong(ulong(28)+128+16) == 23 && ulong(ulong(28)+128+4) <= size-23 &&
               string(ulong(ulong(28)+128+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+128+4)+22) == 0)
           || (ushort(44) > 5 && ulong(ulong(28)+160) == 3 &&
               ulong(ulong(28)+160+16) == 23 && ulong(ulong(28)+160+4) <= size-23 &&
               string(ulong(ulong(28)+160+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+160+4)+22) == 0)
           || (ushort(44) > 6 && ulong(ulong(28)+192) == 3 &&
               ulong(ulong(28)+192+16) == 23 && ulong(ulong(28)+192+4) <= size-23 &&
               string(ulong(ulong(28)+192+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+192+4)+22) == 0)
           || (ushort(44) > 7 && ulong(ulong(28)+224) == 3 &&
               ulong(ulong(28)+224+16) == 23 && ulong(ulong(28)+224+4) <= size-23 &&
               string(ulong(ulong(28)+224+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+224+4)+22) == 0)
           || (ushort(44) > 8 && ulong(ulong(28)+256) == 3 &&
               ulong(ulong(28)+256+16) == 23 && ulong(ulong(28)+256+4) <= size-23 &&
               string(ulong(ulong(28)+256+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+256+4)+22) == 0)
           || (ushort(44) > 9 && ulong(ulong(28)+288) == 3 &&
               ulong(ulong(28)+288+16) == 23 && ulong(ulong(28)+288+4) <= size-23 &&
               string(ulong(ulong(28)+288+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+288+4)+22) == 0)
           || (ushort(44) > 10 && ulong(ulong(28)+320) == 3 &&
               ulong(ulong(28)+320+16) == 23 && ulong(ulong(28)+320+4) <= size-23 &&
               string(ulong(ulong(28)+320+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+320+4)+22) == 0)
           || (ushort(44) > 11 && ulong(ulong(28)+352) == 3 &&
               ulong(ulong(28)+352+16) == 23 && ulong(ulong(28)+352+4) <= size-23 &&
               string(ulong(ulong(28)+352+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+352+4)+22) == 0)
           || (ushort(44) > 12 && ulong(ulong(28)+384) == 3 &&
               ulong(ulong(28)+384+16) == 23 && ulong(ulong(28)+384+4) <= size-23 &&
               string(ulong(ulong(28)+384+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+384+4)+22) == 0)
           || (ushort(44) > 13 && ulong(ulong(28)+416) == 3 &&
               ulong(ulong(28)+416+16) == 23 && ulong(ulong(28)+416+4) <= size-23 &&
               string(ulong(ulong(28)+416+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+416+4)+22) == 0)
           || (ushort(44) > 14 && ulong(ulong(28)+448) == 3 &&
               ulong(ulong(28)+448+16) == 23 && ulong(ulong(28)+448+4) <= size-23 &&
               string(ulong(ulong(28)+448+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+448+4)+22) == 0)
           || (ushort(44) > 15 && ulong(ulong(28)+480) == 3 &&
               ulong(ulong(28)+480+16) == 23 && ulong(ulong(28)+480+4) <= size-23 &&
               string(ulong(ulong(28)+480+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+480+4)+22) == 0)
           || (ushort(44) > 16 && ulong(ulong(28)+512) == 3 &&
               ulong(ulong(28)+512+16) == 23 && ulong(ulong(28)+512+4) <= size-23 &&
               string(ulong(ulong(28)+512+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+512+4)+22) == 0)
           || (ushort(44) > 17 && ulong(ulong(28)+544) == 3 &&
               ulong(ulong(28)+544+16) == 23 && ulong(ulong(28)+544+4) <= size-23 &&
               string(ulong(ulong(28)+544+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+544+4)+22) == 0)
           || (ushort(44) > 18 && ulong(ulong(28)+576) == 3 &&
               ulong(ulong(28)+576+16) == 23 && ulong(ulong(28)+576+4) <= size-23 &&
               string(ulong(ulong(28)+576+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+576+4)+22) == 0)
           || (ushort(44) > 19 && ulong(ulong(28)+608) == 3 &&
               ulong(ulong(28)+608+16) == 23 && ulong(ulong(28)+608+4) <= size-23 &&
               string(ulong(ulong(28)+608+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+608+4)+22) == 0)
           || (ushort(44) > 20 && ulong(ulong(28)+640) == 3 &&
               ulong(ulong(28)+640+16) == 23 && ulong(ulong(28)+640+4) <= size-23 &&
               string(ulong(ulong(28)+640+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+640+4)+22) == 0)
           || (ushort(44) > 21 && ulong(ulong(28)+672) == 3 &&
               ulong(ulong(28)+672+16) == 23 && ulong(ulong(28)+672+4) <= size-23 &&
               string(ulong(ulong(28)+672+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+672+4)+22) == 0)
           || (ushort(44) > 22 && ulong(ulong(28)+704) == 3 &&
               ulong(ulong(28)+704+16) == 23 && ulong(ulong(28)+704+4) <= size-23 &&
               string(ulong(ulong(28)+704+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+704+4)+22) == 0)
           || (ushort(44) > 23 && ulong(ulong(28)+736) == 3 &&
               ulong(ulong(28)+736+16) == 23 && ulong(ulong(28)+736+4) <= size-23 &&
               string(ulong(ulong(28)+736+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+736+4)+22) == 0)
           || (ushort(44) > 24 && ulong(ulong(28)+768) == 3 &&
               ulong(ulong(28)+768+16) == 23 && ulong(ulong(28)+768+4) <= size-23 &&
               string(ulong(ulong(28)+768+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+768+4)+22) == 0)
           || (ushort(44) > 25 && ulong(ulong(28)+800) == 3 &&
               ulong(ulong(28)+800+16) == 23 && ulong(ulong(28)+800+4) <= size-23 &&
               string(ulong(ulong(28)+800+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+800+4)+22) == 0)
           || (ushort(44) > 26 && ulong(ulong(28)+832) == 3 &&
               ulong(ulong(28)+832+16) == 23 && ulong(ulong(28)+832+4) <= size-23 &&
               string(ulong(ulong(28)+832+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+832+4)+22) == 0)
           || (ushort(44) > 27 && ulong(ulong(28)+864) == 3 &&
               ulong(ulong(28)+864+16) == 23 && ulong(ulong(28)+864+4) <= size-23 &&
               string(ulong(ulong(28)+864+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+864+4)+22) == 0)
           || (ushort(44) > 28 && ulong(ulong(28)+896) == 3 &&
               ulong(ulong(28)+896+16) == 23 && ulong(ulong(28)+896+4) <= size-23 &&
               string(ulong(ulong(28)+896+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+896+4)+22) == 0)
           || (ushort(44) > 29 && ulong(ulong(28)+928) == 3 &&
               ulong(ulong(28)+928+16) == 23 && ulong(ulong(28)+928+4) <= size-23 &&
               string(ulong(ulong(28)+928+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+928+4)+22) == 0)
           || (ushort(44) > 30 && ulong(ulong(28)+960) == 3 &&
               ulong(ulong(28)+960+16) == 23 && ulong(ulong(28)+960+4) <= size-23 &&
               string(ulong(ulong(28)+960+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+960+4)+22) == 0)
           || (ushort(44) > 31 && ulong(ulong(28)+992) == 3 &&
               ulong(ulong(28)+992+16) == 23 && ulong(ulong(28)+992+4) <= size-23 &&
               string(ulong(ulong(28)+992+4),22) == "/usr/libexec/ld.elf_so" && char(ulong(ulong(28)+992+4)+22) == 0)
          );
    LEGEND Native NetBSD application
    CMD OPEN $LEADER $REST
    CMD DROP $TARGET $SELECTED
    CMD ALTOPEN launch -c "$LEADER $REST"
    ICON {
        if (opened) {
            include("/emul/irix/usr/lib/filetype/iconlib/generic.exec.open.fti");
        } else {
            include("/emul/irix/usr/lib/filetype/iconlib/generic.exec.closed.fti");
        }
    }
