# The installed gedit accepts positional documents, without the older -f flag.
TYPE XiriGEditExecutable
    SUPERTYPE Executable
    MATCH tag == 0x00010F65;
    LEGEND gEdit the GNOME Notepad
    CMD OPEN $LEADER $REST
    CMD DROP $TARGET $SELECTED
    CMD ALTOPEN launch -c $LEADER $REST
    ICON {
        if (opened) {
            include("/emul/irix/usr/lib/filetype/iconlib/generic.exec.open.fti");
            include("/emul/irix/usr/lib/filetype/install/iconlib/gedit.open.fti");
        } else {
            include("/emul/irix/usr/lib/filetype/iconlib/generic.exec.closed.fti");
            include("/emul/irix/usr/lib/filetype/install/iconlib/gedit.closed.fti");
        }
    }

# Keep the vendor's device name, artwork and localized label.
TYPE XiriAudioMicrophone
    MATCH glob("microphone") && string(0,14) == "XiriMicrophone";
    LEGEND :756:microphone
    CMD OPEN /usr/local/libexec/xiri/recorder-microphone
    CMD ALTOPEN /usr/local/libexec/xiri/recorder-microphone
    ICON {
        include("/emul/irix/usr/lib/filetype/devices/iconlib/microphone.fti");
    }

# The native optical service publishes one of these markers for cd0.
TYPE XiriCDROMEmpty
    MATCH glob("CDROM") && string(0,12) == "XiriCD-empty";
    LEGEND Unloaded CDROM Drive
    CMD OPEN /usr/X11R7/bin/xmessage -center -title CDROM -buttons OK "The CD-ROM drive is empty."
    ICON {
        include("/emul/irix/usr/lib/filetype/devices/iconlib/cdrom.unloaded.fti");
    }

TYPE XiriCDROMData
    MATCH glob("CDROM") && string(0,11) == "XiriCD-data";
    LEGEND ISO9660 CDROM Drive
    CMD OPEN /usr/sbin/fm /CDROM
    CMD ALTOPEN /usr/sbin/fm /CDROM
    MENUCMD "Eject CDROM" /usr/local/libexec/xiri/cdromd --eject || /usr/X11R7/bin/xmessage -center -title CDROM -buttons OK "Could not eject the disc. Close open files on the disc and try again."
    ICON {
        include("/emul/irix/usr/lib/filetype/devices/iconlib/cdrom.loaded.fti");
        include("/emul/irix/usr/lib/filetype/devices/iconlib/addon.iso9660.fti");
    }

TYPE XiriCDROMMusic
    MATCH glob("CDROM") && string(0,12) == "XiriCD-music";
    LEGEND Music CDROM Drive
    CMD OPEN /usr/local/libexec/xiri/cd-player.sh
    CMD ALTOPEN /usr/local/libexec/xiri/cd-player.sh
    MENUCMD "SGI CD Player" /usr/sbin/cdman
    MENUCMD "Eject CDROM" /usr/local/libexec/xiri/cdromd --eject || /usr/X11R7/bin/xmessage -center -title CDROM -buttons OK "Could not eject the disc."
    ICON {
        include("/emul/irix/usr/lib/filetype/devices/iconlib/cdrom.loaded.fti");
        include("/emul/irix/usr/lib/filetype/devices/iconlib/addon.music.fti");
    }

TYPE XiriCDROMOther
    MATCH glob("CDROM") && string(0,12) == "XiriCD-other";
    LEGEND CDROM Drive
    CMD OPEN /usr/X11R7/bin/xmessage -center -title CDROM -buttons OK "This disc is not mounted at /CDROM."
    MENUCMD "Eject CDROM" /usr/local/libexec/xiri/cdromd --eject || /usr/X11R7/bin/xmessage -center -title CDROM -buttons OK "Could not eject the disc."
    ICON {
        include("/emul/irix/usr/lib/filetype/devices/iconlib/cdrom.loaded.fti");
    }
