! Use the imported SGI bitmap face for terminal text. The wildcard Courier
! default can select a Type1 face that intermittently returns 12x2 metrics
! from the current Xorg server. Existing display resources take precedence.
winterm*font: -sgi-screen-medium-r-normal--15-150-72-72-m-80-iso8859-1
XWsh*font: -sgi-screen-medium-r-normal--15-150-72-72-m-80-iso8859-1
