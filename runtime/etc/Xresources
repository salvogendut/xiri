! Select NetBSD's 100dpi bitmap Courier explicitly. It matches the original
! XWsh request without the earlier wildcard selecting a scalable Type1 face
! with intermittent collapsed metrics. Existing display resources win.
winterm*font: -adobe-courier-bold-r-normal--20-140-100-100-m-110-iso8859-1
XWsh*font: -adobe-courier-bold-r-normal--20-140-100-100-m-110-iso8859-1
