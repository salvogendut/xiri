#!/bin/sh
# PROVIDE: xiri_famd
# REQUIRE: rpcbind xiri_devices
# BEFORE: LOGIN
# KEYWORD: shutdown
. /etc/rc.subr
name=xiri_famd
rcvar=$name
command=/usr/local/sbin/famd
pidfile=/var/run/xiri_famd.pid
required_files=/etc/xiri/fam.conf
start_cmd=xiri_famd_start
stop_postcmd=xiri_famd_stopped
xiri_famd_stopped()
{
    # FAM's default SIGTERM exit does not run its C++ Listener destructor.
    # rc.subr calls this only after stopping our matched PID. Remove our v1
    # registration so a normal service restart does not look like an ownerless
    # external daemon. Never unregister a service in the start/refusal path.
    test -n "$rc_pid" || return 1
    if rpcinfo -p 127.0.0.1 | awk '$1 == 391002 && $2 == 1 {found=1} END {exit !found}'; then
        rpcinfo -d 391002 1 || return 1
    fi
    rm -f "$pidfile"
}
xiri_famd_start()
{
    test -z "$rc_pid" || return 0
    test -r "$required_files" && test -x "$command" || return 1
    # Never claim another daemon or overwrite its portmapper registration.
    if pgrep -x famd >/dev/null || rpcinfo -p 127.0.0.1 | awk '$1 == 391002 {found=1} END {exit !found}'; then
        echo 'FAM is already running outside xiri_famd.' >&2
        return 1
    fi
    test "$(readlink /usr/lib/desktop)" = /emul/irix/usr/lib/desktop || return 1
    rpcinfo -p 127.0.0.1 >/dev/null || return 1
    umask 022
    (exec env XIRI_FAM_EXEC=1 XIRI_FAM_ROOT=/emul/irix \
        "$command" -d -c /etc/xiri/fam.conf -p 391002.1) \
        </dev/null >>/var/log/xiri-fam.log 2>&1 &
    service_pid=$!
    echo "$service_pid" >"$pidfile"
    tries=0
    until rpcinfo -p 127.0.0.1 | awk '$1 == 391002 && $2 == 1 && $3 == "tcp" {found=1} END {exit !found}'; do
        tries=$((tries+1))
        if test "$tries" -ge 20 || ! kill -0 "$service_pid" 2>/dev/null; then
            kill "$service_pid" 2>/dev/null || :
            wait "$service_pid" 2>/dev/null || :
            rm -f "$pidfile"
            echo 'FAM did not register; see /var/log/xiri-fam.log.' >&2
            return 1
        fi
        sleep 1
    done
}
load_rc_config "$name"
run_rc_command "$1"
