#!/bin/sh
# PROVIDE: xiri_devices
# REQUIRE: modules mountall
# BEFORE: LOGIN
. /etc/rc.subr
name=xiri_devices
rcvar=$name
start_cmd=xiri_devices_start
stop_cmd=:
xiri_semaphore_device()
{
    local dir=/emul/irix/dev node=/emul/irix/dev/usemaclone
    [ -d "$dir" ] || return 0
    sysctl -n kern.drivers | grep -q ' xiriusema]' || return 0
    [ ! -L "$dir" ] && [ ! -L "$node" ] || return 1
    [ ! -e "$node" ] || [ -c "$node" ] || return 1
    mknod -r -m 666 "$node" c xiriusema 0
}

xiri_audio_devices()
{
    [ -c /dev/audioctl0 ] && [ "$(audioctl -d /dev/audioctl0 -n name)" = HAL2 ] || return 0
    sysctl -n kern.drivers | grep -q ' xirihdsp]' || return 0
    local nodes=/var/run/xiri-hdsp aliases=/emul/irix/dev/hdsp name target
    [ ! -L "$nodes" ] && [ ! -L "$aliases" ] || return 1
    mkdir -p -m 755 "$nodes" "$aliases" || return 1
    [ ! -L "$nodes/events" ] && [ ! -L "$nodes/pcm" ] || return 1
    mknod -r -m 666 "$nodes/events" c xirihdsp 0 &&
        mknod -r -m 666 "$nodes/pcm" c xirihdsp 2 || return 1
    for name in hdsp0master hdsp0events hdsp0r2; do
        case $name in
            hdsp0master) target=/../dev/audioctl0 ;;
            hdsp0events) target=/..$nodes/events ;;
            hdsp0r2) target=/..$nodes/pcm ;;
        esac
        if [ -L "$aliases/$name" ]; then
            [ "$(readlink "$aliases/$name")" = "$target" ] || return 1
        else
            ln -s "$target" "$aliases/$name" || return 1
        fi
    done
}
xiri_cdrom_device()
{
    local raw=/dev/rcd0c aliases=/emul/irix/dev/scsi name path
    [ -d /emul/irix/dev ] || return 0
    [ ! -L "$aliases" ] || return 1
    name=
    if [ -c "$raw" ]; then
        name=$(scsictl "$raw" identify 2>/dev/null |
            sed -n 's|^/dev/rcd0c: scsibus\([0-9][0-9]*\) target \([0-9][0-9]*\) lun 0 .*|sc\1d\2l0|p')
    fi
    # Drop only our old alias if the drive moved or was removed.
    for path in "$aliases"/sc[0-9]*d[0-9]*l0; do
        [ -L "$path" ] && [ "$(readlink "$path")" = "/..$raw" ] || continue
        [ "$path" = "$aliases/$name" ] || rm "$path" || return 1
    done
    [ -n "$name" ] || return 0
    mkdir -p -m 755 "$aliases" || return 1
    if [ -L "$aliases/$name" ]; then
        [ "$(readlink "$aliases/$name")" = "/..$raw" ]
    else
        ln -s "/..$raw" "$aliases/$name"
    fi
}
xiri_devices_start()
{
    /usr/local/sbin/xiri-sync-users || return 1
    xiri_semaphore_device || return 1
    xiri_audio_devices || return 1
    xiri_cdrom_device || warn "Could not prepare the IRIX CD-ROM device alias"
    # Run before login/PTY allocation. A service restart must not remount PTYs.
    test ! -f /var/run/xiri-pty-ready || return 0
    /bin/sh /usr/local/libexec/xiri/setup-pty.sh || return 1
    touch /var/run/xiri-pty-ready
}
load_rc_config "$name"
run_rc_command "$1"
