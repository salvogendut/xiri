#!/bin/sh
# PROVIDE: xiri_devices
# REQUIRE: mountall
# BEFORE: LOGIN
. /etc/rc.subr
name=xiri_devices
rcvar=$name
start_cmd=xiri_devices_start
stop_cmd=:
xiri_devices_start()
{
    /usr/local/sbin/xiri-sync-users || return 1
    # Run before login/PTY allocation. A service restart must not remount PTYs.
    test ! -f /var/run/xiri-pty-ready || return 0
    /bin/sh /usr/local/libexec/xiri/setup-pty.sh || return 1
    touch /var/run/xiri-pty-ready
}
load_rc_config "$name"
run_rc_command "$1"
