# Keep the imported system menus; adapt the applications qualified on Xiri.
# f.exec honors MWMSHELL. The vendor .sh operators force IRIX /bin/sh.
include /usr/lib/X11/system.chestrc

remove "Open Unix Shell" from Desktop
Menu Desktop
{
    "Open Unix Shell" f.exec "/usr/local/bin/xiri-launch winterm"
}

remove "Icon Catalog" from Find
Menu Find
{
    "Icon Catalog" f.exec "/usr/local/bin/xiri-launch iconcatalog"
}

remove "Log Out" from Desktop
Menu Desktop
{
    "Log Out" f.exec "/usr/local/bin/xiri-logout"
}
