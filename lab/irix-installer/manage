#!/bin/sh
# One root-authorized Software Manager transaction on local mounted installation media.
set -eu
export PATH=/bin:/usr/bin:/sbin:/usr/sbin HOME=/ USER=root LOGNAME=root LANG=C TZ=UTC
test "$(id -u)" = 0 || exit 1
cd /
root=/emul/irix
types=$root/usr/lib/filetype
table=$types/desktop.otr
fail() { echo "$*" >&2; exit 1; }
export DISPLAY=127.0.0.1:0
XAUTHORITY=$(ps -axww -o uid,args | awk '$1==0 && $2 ~ /^\/usr\/X11R7\/bin\/X(org)?$/ && $3==":0" {for(i=4;i<NF;i++) if($i=="-auth") print $(i+1)}')
export XAUTHORITY
test -f "$XAUTHORITY" || fail 'The local xdm display is unavailable.'
# Expose a numbered list, including the standard attachment on a fresh boot.
mkdir -p /mnt/freeware
if ! mount | grep -q ' on /mnt/freeware '; then
    mount -rt cd9660 /dev/cd1a /mnt/freeware 2>/dev/null || :
fi
set --
for m in $(mount -t cd9660 | awk '{print $3}'); do
    test -d "$m/dist" || continue
    set -- "$@" "$m/dist"
    echo "$#) $m"
done
test "$#" -gt 0 || fail 'Attach the Freeware CD or mount the distribution disc.'
if test "$#" -gt 1; then
    printf 'Disc number: '; IFS= read -r choice
    case "$choice" in ''|*[!0-9]*|0) exit 1 ;; esac
    test "$choice" -le "$#"; shift "$((choice-1))"
fi
dist=$1
printf '\033]0;Software Manager media\007' >/dev/tty
echo 'Enter a product name to narrow the list, or press Return for the whole disc.'
printf 'Product: '; IFS= read -r product
set -- -f "$dist"
if test -n "$product"; then
    case "$product" in *[!A-Za-z0-9_+.-]*|.*|-*) exit 1 ;; esac
    test -f "$dist/$product.idb" || fail "No $product on this disc."
    set -- -f "$dist/$product"
    if test "$product" != fw_common && test -f "$dist/fw_common.idb"; then set -- "$@" -f "$dist/fw_common"; fi
fi
set -- "$@" -K '*'
if test -n "$product"; then
    printf 'Initial selection (install, remove, or Return to review): '
    IFS= read -r selection
    case "$selection" in
        install)
            set -- "$@" -I "$product.sw"
            if test "$product" != fw_common && test -f "$dist/fw_common.idb"; then set -- "$@" -I fw_common.sw.index; fi ;;
        remove) set -- "$@" -R "$product" ;;
        '') ;;
        *) fail 'Unknown selection.' ;;
    esac
fi
package=desktop
action=install
. /usr/local/libexec/xiri-software/desktop-artwork.sh
mounted=no
cleanup() {
    if test "$own_game_lock" = yes && test "$types/makefile" -ef "$game_state/lock/desktop.mk"; then rm "$types/makefile"; fi
    if test "$mounted" = yes; then umount "$root/tmp"; fi
    artwork_close
}
trap cleanup EXIT
trap 'exit 1' HUP INT TERM
artwork_open
mkdir -p "$root/tmp"
if test ! /tmp -ef "$root/tmp"; then
    test -z "$(ls -A "$root/tmp")" || fail "Existing files in $root/tmp prevent sharing installer scratch."
    mount -t null /tmp "$root/tmp"
    mounted=yes
fi
test ! -e "$types/makefile" && test ! -L "$types/makefile" || fail 'A local filetype makefile is already installed.'
# SGI invokes make inside the alternate root. Compile the installed rules together
# after Software Manager has finished all of the user's selected transactions.
printf 'all:\n\t@:\n' >"$game_state/lock/desktop.mk"
ln "$game_state/lock/desktop.mk" "$types/makefile"
rules() { (cd "$types/install" && for f in *.ftr; do test ! -f "$f" || printf '%s\n' "${f%.ftr}"; done) | LC_ALL=C sort; }
before=$art/before-desktop
if test ! -f "$before"; then rules >"$stage/before"; mv "$stage/before" "$before"; fi
rc=0
"$root/usr/sbin/swmgr" -V background:off -r "$root" "$@" </dev/null || rc=$?
rules >"$stage/after"
comm -13 "$before" "$stage/after" >"$stage/new"
while IFS= read -r name; do
    case "$name" in ''|*[!A-Za-z0-9_+-]*) fail "Unsupported filetype name $name." ;; esac
    touch "$art/rule.$name"
done <"$stage/new"
for mark in "$art"/rule.* "$art/xmahjongg" "$art/unzip" "$art/gimp"; do
    test -f "$mark" || continue
    name=${mark##*/}; name=${name#rule.}
    test -f "$types/install/$name.ftr" || rm "$mark"
done
# Use legacy receipt names for the packages also supported by the disc-specific helpers.
for name in xmahjongg unzip gimp; do
    if test -f "$art/rule.$name"; then mv -f "$art/rule.$name" "$art/$name"; fi
done
artwork_publish
rm -f "$before"
artwork_release_base
exit "$rc"
